# ──────────────────────────────────────────────
# Inventory Management Agent — API Keys
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your real keys.
# If keys are missing, the agent runs with simulated responses.

# 1. Order Management System
ORDER_MGMT_API_KEY=your_order_mgmt_api_key_here
ORDER_MGMT_BASE_URL=https://api.ordermgmt.example.com/v1

# 2. Inventory Database
INVENTORY_DB_API_KEY=your_inventory_db_api_key_here
INVENTORY_DB_BASE_URL=https://api.inventory.example.com/v1

# 3. Payment Gateway (e.g., Stripe)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key_here
PAYMENT_GATEWAY_BASE_URL=https://api.payment.example.com/v1

# 4. Invoice Generator
INVOICE_GEN_API_KEY=your_invoice_gen_api_key_here
INVOICE_GEN_BASE_URL=https://api.invoicegen.example.com/v1

# 5. Delivery Service (e.g., FedEx / UPS)
DELIVERY_API_KEY=your_delivery_api_key_here
DELIVERY_BASE_URL=https://api.delivery.example.com/v1

# 6. Customer Notification Service (e.g., SendGrid / Twilio)
NOTIFICATION_API_KEY=your_notification_api_key_here
NOTIFICATION_BASE_URL=https://api.notify.example.com/v1
